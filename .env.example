# Clinic Prep Assistant — environment template (safe to commit; no secrets here)
# Copy to .env and fill the two values you provide: ANTHROPIC_API_KEY + VERCEL_TOKEN.

# ── Anthropic (Claude) ──────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Vercel (CLI deploys) ────────────────────────────────────────────
# Personal token: https://vercel.com/account/tokens
VERCEL_TOKEN=

# ── Supabase (LOCAL stack on this laptop) ───────────────────────────
# These come from `supabase status` after `supabase start` (local-dev defaults,
# deterministic — you do NOT source them from anywhere).
# LOCAL dev value:
SUPABASE_URL=http://127.0.0.1:54321
# For the VERCEL deploy, set SUPABASE_URL to your cloudflared/ngrok tunnel URL.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── Agent model ─────────────────────────────────────────────────────
# Fast default for the live demo; switch to claude-opus-4-8 for max quality.
CLAUDE_MODEL=claude-sonnet-4-6
